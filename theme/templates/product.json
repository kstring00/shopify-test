{
  "sections": {
    "main": {
      "type": "product-information",
      "blocks": {
        "media-gallery": {
          "type": "_product-media-gallery",
          "static": true,
          "settings": {
            "media_presentation": "carousel",
            "media_columns": "one",
            "image_gap": 8,
            "large_first_image": false,
            "icons_style": "chevron",
            "slideshow_controls_style": "thumbnails",
            "slideshow_mobile_controls_style": "dots",
            "thumbnail_position": "bottom",
            "thumbnail_width": 72,
            "thumbnail_radius": 8,
            "aspect_ratio": "adapt",
            "constrain_to_viewport": true,
            "media_fit": "contain",
            "media_radius": 14,
            "extend_media": false,
            "zoom": true,
            "video_loop": false,
            "hide_variants": false,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "details_position": "flex-start",
            "gap": 20,
            "sticky_details_desktop": true,
            "background_media": "none",
            "background_color": "",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_color": "",
            "border_radius": 0,
            "padding-block-start": 8,
            "padding-block-end": 24,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "title": {
              "type": "text",
              "name": "t:names.product_title",
              "settings": {
                "text": "<h1>{{ closest.product.title }}</h1>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h2",
                "font": "var(--font-heading--family)",
                "font_size": "",
                "line_height": "tight",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "balance",
                "text_color": "",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "benefit": {
              "type": "tss-benefit",
              "settings": {
                "text": "",
                "size": "large"
              },
              "blocks": {}
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "h5",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-subheading--family)",
                "font_size": "1.25rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "text_color": "",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "format": {
              "type": "tss-format",
              "settings": {
                "heading": "Format & what's included",
                "format_line": "Editable [format] template. Instant delivery after purchase.",
                "included": "<ul><li>Change the wording, colors and logo so it feels like yours.</li><li>Download link on the confirmation page and in your email, right after checkout.</li><li>Print it, email it, or share it on a screen as often as you need.</li></ul>",
                "note": ""
              },
              "blocks": {}
            },
            "buy_buttons": {
              "type": "buy-buttons",
              "settings": {
                "stacking": true,
                "text_color": "",
                "show_pickup_availability": false,
                "gift_card_form": false,
                "recipient_button_style": "default",
                "recipient_button_background": "{{ settings.color_palette.background }}",
                "recipient_button_text": "{{ settings.color_palette.foreground }}",
                "recipient_button_border": "{{ settings.color_palette.foreground }}",
                "selected_recipient_button_style": "default",
                "selected_recipient_button_background": "{{ settings.color_palette.foreground }}",
                "selected_recipient_button_text": "{{ settings.color_palette.background }}",
                "selected_recipient_button_border": "{{ settings.color_palette.foreground }}",
                "input_style": "default",
                "input_background_color": "{{ settings.color_palette.background }}",
                "input_text_color": "{{ settings.color_palette.foreground }}",
                "input_border_color": "{{ settings.color_palette.foreground }}",
                "border_width": 1,
                "border_radius": 10,
                "padding-block-start": 4,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {
                "quantity": {
                  "type": "quantity",
                  "static": true,
                  "settings": {
                    "input_style": "default",
                    "input_background_color": "{{ settings.color_palette.background }}",
                    "input_text_color": "{{ settings.color_palette.foreground }}",
                    "input_border_color": "{{ settings.color_palette.foreground }}",
                    "border_width": 1,
                    "border_radius": 10
                  },
                  "blocks": {}
                },
                "add-to-cart": {
                  "type": "add-to-cart",
                  "static": true,
                  "settings": {
                    "style_class": "button",
                    "custom_button_background": "{{ settings.color_palette.color2 }}",
                    "custom_button_text": "{{ settings.color_palette.background }}",
                    "custom_button_border": "{{ settings.color_palette.color2 }}"
                  },
                  "blocks": {}
                },
                "accelerated-checkout": {
                  "type": "accelerated-checkout",
                  "static": true,
                  "settings": {},
                  "blocks": {}
                }
              },
              "block_order": []
            },
            "guarantee": {
              "type": "tss-guarantee",
              "settings": {
                "text": "Digital files can't be returned, so here is the promise instead: if a kit doesn't do what the page says it does, email us and we'll make it right.",
                "link_label": "Read the refund policy",
                "fallback_link_label": "Ask us anything first",
                "fallback_link": "shopify://pages/contact"
              },
              "blocks": {}
            },
            "trust": {
              "type": "tss-trust-strip",
              "settings": {
                "title_1": "No client data",
                "text_1": "Nothing in these files touches your records or theirs.",
                "title_2": "No treatment recommendations",
                "text_2": "Formats and wording, not clinical guidance.",
                "title_3": "You customize everything",
                "text_3": "Every line is yours to change before it reaches a family."
              },
              "blocks": {}
            }
          },
          "block_order": ["title", "benefit", "price", "format", "buy_buttons", "guarantee", "trust"]
        }
      },
      "block_order": [],
      "settings": {
        "content_width": "content-center-aligned",
        "desktop_media_position": "left",
        "equal_columns": true,
        "limit_details_width": true,
        "gap": 48,
        "enable_sticky_add_to_cart": true,
        "background_color": "",
        "padding-block-start": 32,
        "padding-block-end": 48
      }
    },
    "inside": {
      "type": "tss-inside-kit",
      "blocks": {
        "clinic_1": { "type": "item", "settings": { "title": "Welcome letter", "text": "A warm first page families actually read.", "product": "clinic-welcome-kit-builder" } },
        "clinic_2": { "type": "item", "settings": { "title": "What to expect in week one", "text": "Sessions, check-ins and who to call.", "product": "clinic-welcome-kit-builder" } },
        "clinic_3": { "type": "item", "settings": { "title": "Clinic policies one-pager", "text": "Attendance, cancellations and communication in plain language.", "product": "clinic-welcome-kit-builder" } },
        "clinic_4": { "type": "item", "settings": { "title": "Meet the team page", "text": "Photos and roles so faces have names from day one.", "product": "clinic-welcome-kit-builder" } },
        "clinic_5": { "type": "item", "settings": { "title": "Parent FAQ sheet", "text": "The questions every new family asks, answered once.", "product": "clinic-welcome-kit-builder" } },
        "clinic_6": { "type": "item", "settings": { "title": "Contact and scheduling card", "text": "Print it, stick it on the fridge.", "product": "clinic-welcome-kit-builder" } },
        "news_1": { "type": "item", "settings": { "title": "Monthly newsletter layout", "text": "Headline, highlights, dates and a note from the team.", "product": "parent-newsletter-studio" } },
        "news_2": { "type": "item", "settings": { "title": "Reminder and update cards", "text": "Short formats for schedule changes and quick wins.", "product": "parent-newsletter-studio" } },
        "news_3": { "type": "item", "settings": { "title": "Seasonal variations", "text": "Swap the palette without rebuilding the page.", "product": "parent-newsletter-studio" } },
        "news_4": { "type": "item", "settings": { "title": "Reusable content blocks", "text": "Drop-in sections so no issue starts from blank.", "product": "parent-newsletter-studio" } },
        "routine_1": { "type": "item", "settings": { "title": "Morning routine board", "text": "Picture-first steps for the start of the day.", "product": "daily-routine-kit" } },
        "routine_2": { "type": "item", "settings": { "title": "Bedtime routine board", "text": "Wind-down steps in the same calm style.", "product": "daily-routine-kit" } },
        "routine_3": { "type": "item", "settings": { "title": "Transition cards", "text": "First-then cards for the moments that are hardest.", "product": "daily-routine-kit" } },
        "routine_4": { "type": "item", "settings": { "title": "Blank editable cards", "text": "Add the steps that are unique to your home.", "product": "daily-routine-kit" } }
      },
      "block_order": ["clinic_1", "clinic_2", "clinic_3", "clinic_4", "clinic_5", "clinic_6", "news_1", "news_2", "news_3", "news_4", "routine_1", "routine_2", "routine_3", "routine_4"],
      "settings": {
        "eyebrow": "What you get",
        "heading": "Inside this kit",
        "intro": "",
        "use_description": true,
        "tone": "cream"
      }
    },
    "who": {
      "type": "tss-who-for",
      "blocks": {
        "clinic_fit": { "type": "audience", "settings": { "kind": "fit", "label": "Made for", "title": "Clinic owners and admins onboarding new families", "text": "You want the first week to feel organized and warm without building every document from scratch.", "product": "clinic-welcome-kit-builder" } },
        "clinic_stretch": { "type": "audience", "settings": { "kind": "stretch", "label": "Also works for", "title": "Lead BCBAs standardizing intake across locations", "text": "One kit, one look, every site. Change the clinic name and you are done.", "product": "clinic-welcome-kit-builder" } },
        "news_fit": { "type": "audience", "settings": { "kind": "fit", "label": "Made for", "title": "Clinics that want to stay in touch with parents monthly", "text": "You know communication matters and you do not have a designer on staff.", "product": "parent-newsletter-studio" } },
        "news_stretch": { "type": "audience", "settings": { "kind": "stretch", "label": "Also works for", "title": "Office managers sending schedule and policy updates", "text": "Short-format cards for the messages that cannot wait for next month.", "product": "parent-newsletter-studio" } },
        "routine_fit": { "type": "audience", "settings": { "kind": "fit", "label": "Made for", "title": "Parents and caregivers who want calmer mornings and bedtimes", "text": "Visual steps your child can follow, in a style you are happy to have on the wall.", "product": "daily-routine-kit" } },
        "routine_stretch": { "type": "audience", "settings": { "kind": "stretch", "label": "Also works for", "title": "Clinicians sending routines home", "text": "Hand families something consistent with what they practice in session.", "product": "daily-routine-kit" } }
      },
      "block_order": ["clinic_fit", "clinic_stretch", "news_fit", "news_stretch", "routine_fit", "routine_stretch"],
      "settings": {
        "eyebrow": "Who it's for",
        "heading": "Built for a specific desk.",
        "text": "",
        "tone": "card"
      }
    },
    "founder_note": {
      "type": "tss-founder",
      "settings": {
        "layout": "note",
        "eyebrow": "A note from Kyle",
        "heading": "Why this exists",
        "body": "<p>I work inside ABA clinics with kids and parents every day, and I design for the web the rest of the time. Every kit on this shelf started as something a clinic or a family actually needed and could not find done well. If it does not help, tell me and I will fix it.</p>",
        "image_alt": "Kyle, founder of The Support Shelf",
        "name": "Kyle",
        "role": "Founder, The Support Shelf",
        "cta_label": "",
        "tone": "cream"
      }
    },
    "faq": {
      "type": "tss-faq",
      "blocks": {
        "q1": { "type": "question", "settings": { "question": "Is this editable, or just a PDF?", "answer": "<p>Editable. You get template files you can open and change: wording, colors, logo, the lot. A print-ready PDF is one of the things you can export when you are done.</p>" } },
        "q2": { "type": "question", "settings": { "question": "How is it delivered?", "answer": "<p>Instantly. As soon as checkout completes you get a download link on the confirmation page and in your email. Nothing ships.</p>" } },
        "q3": { "type": "question", "settings": { "question": "Is it safe to use with families?", "answer": "<p>Yes. Nothing here collects or stores client information, and nothing makes treatment recommendations. These are formats and wording you review and adapt before anything reaches a family.</p>" } },
        "q4": { "type": "question", "settings": { "question": "What if it isn't right for us? Can I get a refund?", "answer": "<p>Digital files cannot be returned, so the promise is simple: if a kit does not do what the page says it does, email us and we will make it right. The full policy is linked below the add-to-cart button.</p>" } },
        "q5": { "type": "question", "settings": { "question": "Can I use it for more than one clinic location?", "answer": "<p>Yes, for locations you own or manage. Please do not resell or share the files outside your organization.</p>", "product": "clinic-welcome-kit-builder" } }
      },
      "block_order": ["q1", "q2", "q3", "q4", "q5"],
      "settings": {
        "eyebrow": "Questions",
        "heading": "Before you buy",
        "text": "",
        "contact_label": "Still wondering? Ask us",
        "contact_link": "shopify://pages/contact",
        "open_first": true,
        "structured_data": true,
        "tone": "cream"
      }
    },
    "related": {
      "type": "tss-related",
      "settings": {
        "heading": "More from this shelf",
        "max_products": 3,
        "tone": "card"
      }
    }
