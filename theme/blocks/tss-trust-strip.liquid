{% doc %}
  Three short trust statements for product pages: no client data, no treatment
  recommendations, you customize everything.
{% enddoc %}
{% assign s = block.settings %}
<ul class="tss-trust" role="list" {{ block.shopify_attributes }}>
  {% for i in (1..3) %}
    {% liquid
      assign title_key = 'title_' | append: i
      assign text_key = 'text_' | append: i
      assign title = s[title_key]
      assign text = s[text_key]
    %}
    {% if title != blank %}
      <li class="tss-trust__item">
        <span class="tss-trust__title">{{ title | escape }}</span>
        {% if text != blank %}<span class="tss-trust__text">{{ text | escape }}</span>{% endif %}
      </li>
    {% endif %}
  {% endfor %}
</ul>

{% stylesheet %}
  .tss-trust {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  @media screen and (max-width: 479px) {
    .tss-trust {
      grid-template-columns: 1fr;
    }
  }

  .tss-trust__item {
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    border-radius: var(--tss-radius-sm);
    background: var(--tss-color-sage-tint);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .tss-trust__title {
    font-family: var(--font-subheading--family);
    font-weight: 500;
    color: var(--tss-color-ink);
  }

  .tss-trust__text {
    color: var(--tss-color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:tss.trust.name",
  "tag": null,
  "settings": [
    { "type": "text", "id": "title_1", "label": "t:tss.trust.item_title", "default": "t:tss.trust.title_1_default" },
    { "type": "text", "id": "text_1", "label": "t:tss.trust.item_text", "default": "t:tss.trust.text_1_default" },
    { "type": "text", "id": "title_2", "label": "t:tss.trust.item_title", "default": "t:tss.trust.title_2_default" },
    { "type": "text", "id": "text_2", "label": "t:tss.trust.item_text", "default": "t:tss.trust.text_2_default" },
    { "type": "text", "id": "title_3", "label": "t:tss.trust.item_title", "default": "t:tss.trust.title_3_default" },
    { "type": "text", "id": "text_3", "label": "t:tss.trust.item_text", "default": "t:tss.trust.text_3_default" }
  ],
  "presets": [
    {
      "name": "t:tss.trust.name",
      "category": "t:tss.common.category"
    }
  ]
}
{% endschema %}
