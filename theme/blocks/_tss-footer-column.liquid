{% doc %}
  A footer column: heading plus link blocks. Can also list the store policies
  automatically or show the compact email form.
{% enddoc %}
{% assign s = block.settings %}
<div class="tss-footer__column" {{ block.shopify_attributes }}>
  {% if s.heading != blank %}<h2 class="tss-footer__heading">{{ s.heading | escape }}</h2>{% endif %}
  {% if s.show_email %}
    {% if s.text != blank %}<p class="tss-footer__text tss-muted">{{ s.text | escape }}</p>{% endif %}
    {% render 'tss-email-form', id: block.id %}
  {% else %}
    <ul class="tss-footer__links" role="list">
      {% content_for 'blocks' %}
      {% if s.show_policies %}
        {% for policy in shop.policies %}
          {% if policy != blank %}
            <li><a class="tss-footer__link" href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {% endif %}
        {% endfor %}
      {% endif %}
    </ul>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:tss.footer.column",
  "tag": null,
  "blocks": [
    {
      "type": "_tss-footer-link"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:tss.common.heading",
      "default": "t:tss.footer.column_heading_default"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "t:tss.footer.show_policies",
      "info": "t:tss.footer.show_policies_info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "t:tss.footer.show_email",
      "default": false
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:tss.common.text",
      "visible_if": "{{ block.settings.show_email }}"
    }
  ]
}
{% endschema %}
