{% doc %}
  "Format & what's included" block for product pages. Sits above the add-to-cart button
  and answers "is this editable or just a PDF?". The included list reads the product's
  custom.whats_included metafield (one item per line) when present, otherwise the block's
  own rich text list.
{% enddoc %}
{% liquid
  assign s = block.settings
  assign product = closest.product
  assign included_lines = product.metafields.custom.whats_included.value | newline_to_br | split: '<br />'
%}
<div class="tss-format tss-format--block" {{ block.shopify_attributes }}>
  <h2 class="tss-format__heading">{{ s.heading | escape }}</h2>
  {% if s.format_line != blank %}
    <p class="tss-format__line">
      <span class="svg-wrapper" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
      {{ s.format_line | escape }}
    </p>
  {% endif %}
  {% if included_lines.size > 0 and included_lines[0] != blank %}
    <ul class="tss-checklist">
      {% for line in included_lines %}
        {% assign clean = line | strip %}
        {% if clean != blank %}<li>{{ clean | escape }}</li>{% endif %}
      {% endfor %}
    </ul>
  {% elsif s.included != blank %}
    <div class="tss-format__list tss-prose">{{ s.included }}</div>
  {% endif %}
  {% if s.note != blank %}
    <p class="tss-format__note tss-muted tss-small">{{ s.note | escape }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .tss-format--block {
    background: var(--tss-color-card);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:tss.format.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:tss.common.heading",
      "default": "t:tss.format.heading_default"
    },
    {
      "type": "text",
      "id": "format_line",
      "label": "t:tss.format.format_line",
      "info": "t:tss.format.format_line_info",
      "default": "t:tss.format.format_line_default"
    },
    {
      "type": "richtext",
      "id": "included",
      "label": "t:tss.format.included",
      "info": "t:tss.format.included_info",
      "default": "t:tss.format.included_default"
    },
    {
      "type": "text",
      "id": "note",
      "label": "t:tss.format.note"
    }
  ],
  "presets": [
    {
      "name": "t:tss.format.name",
      "category": "t:tss.common.category"
    }
  ]
}
{% endschema %}
