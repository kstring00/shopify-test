{
  "type": "footer",
  "name": "t:names.footer",
  "sections": {
    "footer_main": {
      "type": "tss-footer",
      "blocks": {
        "shelves": {
          "type": "_tss-footer-column",
          "settings": { "heading": "The shelves", "show_policies": false, "show_email": false, "text": "" },
          "blocks": {
            "clinic": { "type": "_tss-footer-link", "settings": { "label": "", "collection": "the-clinic-shelf", "url": "", "badge": "", "page_handle": "" } },
            "family": { "type": "_tss-footer-link", "settings": { "label": "", "collection": "the-family-shelf", "url": "", "badge": "", "page_handle": "" } },
            "interactive": { "type": "_tss-footer-link", "settings": { "label": "", "collection": "the-interactive-shelf", "url": "", "badge": "Coming soon", "page_handle": "" } }
          },
          "block_order": ["clinic", "family", "interactive"]
        },
        "company": {
          "type": "_tss-footer-column",
          "settings": { "heading": "The Support Shelf", "show_policies": true, "show_email": false, "text": "" },
          "blocks": {
            "about": { "type": "_tss-footer-link", "settings": { "label": "About", "page": "about", "url": "", "badge": "", "page_handle": "about" } },
            "contact": { "type": "_tss-footer-link", "settings": { "label": "Contact", "page": "contact", "url": "", "badge": "", "page_handle": "contact" } }
          },
          "block_order": ["about", "contact"]
        },
        "email": {
          "type": "_tss-footer-column",
          "settings": { "heading": "Get new resources first", "show_policies": false, "show_email": true, "text": "One short email when something new lands on a shelf." },
          "blocks": {},
          "block_order": []
        }
      },
      "block_order": ["shelves", "company", "email"],
      "settings": {
        "tagline": "Thoughtfully made tools for the people who care.",
        "blurb": "Editable resources for ABA clinics and the families they serve, made by someone who works inside clinics every day.",
        "show_contact": true,
        "tone": "card"
      }
    },
    "footer_utilities": {
      "type": "footer-utilities",
      "blocks": {
        "copyright": {
          "type": "footer-copyright",
          "settings": {
            "show_powered_by": false,
            "font_size": "0.75rem",
            "case": "none",
            "text_color": ""
          },
          "blocks": {}
        },
        "policies": {
          "type": "footer-policy-list",
          "settings": {
            "font_size": "0.75rem",
            "case": "none",
            "text_color": ""
          },
          "blocks": {}
        },
        "social": {
          "type": "social-links",
          "settings": {
            "facebook_url": "",
            "instagram_url": "",
            "youtube_url": "",
            "tiktok_url": "",
            "twitter_url": "",
            "threads_url": "",
            "linkedin_url": "",
            "bluesky_url": "",
            "snapchat_url": "",
            "pinterest_url": "",
            "tumblr_url": "",
            "vimeo_url": "",
            "custom_url": ""
          },
          "blocks": {}
        }
      },
      "block_order": ["copyright", "policies", "social"],
      "settings": {
        "section_width": "page-width",
        "gap": 24,
        "divider_thickness": 1,
        "background_color": "{{ settings.color_palette.color3 }}",
        "divider_color": "",
        "padding-block-start": 20,
        "padding-block-end": 20
      }
    }
  },
  "order": ["footer_main", "footer_utilities"]
}
