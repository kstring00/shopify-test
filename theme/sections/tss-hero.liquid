{% comment %}
  Section contract.
  Homepage hero: in five seconds a visitor learns what this is, who it is for and that
  the person behind it has done the work. One dominant CTA, one text-style secondary link.
  Owns the page's single H1.
  @example
  <!-- Added as the first section of templates/index.json -->
{% endcomment %}
{% liquid
  assign s = section.settings
  assign image = s.image
  assign image_alt = s.image_alt | default: shop.name
%}
<div class="tss-section tss-hero tss-section--{{ s.tone }}">
  <div class="tss-container tss-hero__grid">
    <div class="tss-hero__copy" data-reveal>
      {% if s.eyebrow != blank %}
        <p class="tss-eyebrow">{{ s.eyebrow | escape }}</p>
      {% endif %}
      <h1 class="tss-hero__heading">{{ s.heading | escape }}</h1>
      {% if s.subheading != blank %}
        <div class="tss-lede tss-hero__lede">{{ s.subheading }}</div>
      {% endif %}
      <div class="tss-actions">
        {% if s.cta_label != blank %}
          <a class="button tss-cta" href="{{ s.cta_link | default: routes.collections_url }}">
            {{ s.cta_label | escape }}
            <svg class="tss-link__arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">{% render 'icon', icon: 'arrow' %}</svg>
          </a>
        {% endif %}
        {% if s.secondary_label != blank %}
          <a class="tss-link" href="{{ s.secondary_link | default: routes.collections_url }}">
            {{ s.secondary_label | escape }}
            <svg class="tss-link__arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">{% render 'icon', icon: 'arrow' %}</svg>
          </a>
        {% endif %}
      </div>
      {% if section.blocks.size > 0 %}
        <ul class="tss-hero__proof" role="list">
          {% for block in section.blocks %}
            <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
    <div class="tss-hero__visual" data-reveal style="--tss-delay: 0.12s">
      <div class="tss-hero__frame">
        {% if image != blank %}
          {{
            image
            | image_url: width: 1600
            | image_tag:
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(min-width: 990px) 44vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: image_alt
          }}
        {% else %}
          {% assign hero_placeholder_label = s.image_alt %}{% if hero_placeholder_label == blank %}{% assign hero_placeholder_label = 'tss.hero.placeholder_alt' | t %}{% endif %}{% render 'tss-placeholder-media', label: hero_placeholder_label %}
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .tss-hero {
    padding-block: clamp(2.5rem, 6vw, 5.5rem) var(--tss-section-padding);
  }

  .tss-hero__grid {
    display: grid;
    gap: calc(var(--tss-stack) * 1.5);
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .tss-hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 5vw, 5rem);
    }
  }

  .tss-hero__heading {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(2.375rem, 1.5rem + 3.6vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .tss-hero__lede {
    margin-block-start: var(--tss-stack);
    max-width: 54ch;
  }

  .tss-hero__proof {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: calc(var(--tss-stack) * 1.5) 0 0;
    padding: 0;
    font-size: 0.875rem;
    color: var(--tss-color-muted);
  }

  .tss-hero__proof li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tss-hero__proof li::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--tss-color-sage);
  }

  .tss-hero__frame {
    aspect-ratio: 4 / 5;
    max-height: 72vh;
    border-radius: var(--tss-radius-lg);
    overflow: hidden;
    box-shadow: var(--tss-shadow);
    background: var(--tss-color-card);
  }

  @media screen and (max-width: 749px) {
    .tss-hero__frame {
      aspect-ratio: 5 / 4;
    }
  }

  .tss-hero__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:tss.hero.name",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "proof",
      "name": "t:tss.hero.proof_point",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:tss.common.text",
          "default": "t:tss.hero.proof_default"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:tss.common.eyebrow",
      "default": "t:tss.hero.eyebrow_default"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:tss.common.heading",
      "default": "t:tss.hero.heading_default"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:tss.common.subheading",
      "default": "t:tss.hero.subheading_default"
    },
    {
      "type": "header",
      "content": "t:tss.common.primary_cta"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:tss.common.label",
      "default": "t:tss.hero.cta_default"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:tss.common.link"
    },
    {
      "type": "header",
      "content": "t:tss.common.secondary_link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:tss.common.label",
      "default": "t:tss.hero.secondary_default"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:tss.common.link"
    },
    {
      "type": "header",
      "content": "t:tss.common.image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:tss.common.image",
      "info": "t:tss.hero.image_info"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:tss.common.image_alt",
      "default": "t:tss.hero.image_alt_default"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "t:tss.common.tone",
      "options": [
        { "value": "cream", "label": "t:tss.common.tone_cream" },
        { "value": "card", "label": "t:tss.common.tone_card" },
        { "value": "sage", "label": "t:tss.common.tone_sage" }
      ],
      "default": "cream"
    }
  ],
  "presets": [
    {
      "name": "t:tss.hero.name",
      "category": "t:tss.common.category",
      "blocks": {
        "proof_1": { "type": "proof", "settings": { "text": "Built inside ABA clinics" } },
        "proof_2": { "type": "proof", "settings": { "text": "Editable, not just a PDF" } },
        "proof_3": { "type": "proof", "settings": { "text": "Instant download" } }
      },
      "block_order": ["proof_1", "proof_2", "proof_3"]
    }
  ]
}
{% endschema %}
