{% comment %}
  Section contract.
  "More from this shelf": other products from the same shelf collection as the current
  product, as editorial cards. Hides itself when the product has no shelf siblings.
  @example
  <!-- templates/product.json, last section -->
{% endcomment %}
{% liquid
  assign s = section.settings
  assign shelf = blank
  for c in product.collections
    if c.handle contains 'shelf'
      assign shelf = c
      break
    endif
  endfor
  if shelf == blank
    assign shelf = product.collections.first
  endif
  assign siblings = ''
  assign count = 0
  if shelf != blank
    for p in shelf.products
      if p.id != product.id and count < s.max_products
        assign siblings = siblings | append: p.handle | append: ','
        assign count = count | plus: 1
      endif
    endfor
  endif
%}
{% if count > 0 %}
  <div class="tss-section tss-related tss-section--{{ s.tone }}">
    <div class="tss-container">
      <div class="tss-section-head tss-section-head--split" data-reveal>
        <div>
          <p class="tss-eyebrow">{{ shelf.title | escape }}</p>
          <h2 class="tss-heading">{{ s.heading | escape }}</h2>
        </div>
        <div>
          <a class="tss-link" href="{{ shelf.url }}">
            {{ 'tss.related.view_shelf' | t: shelf: shelf.title }}
            <svg class="tss-link__arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">{% render 'icon', icon: 'arrow' %}</svg>
          </a>
        </div>
      </div>
      <div class="tss-related__grid tss-related__grid--{{ count }}">
        {% assign shown = 0 %}
        {% for p in shelf.products %}
          {% assign token = p.handle | append: ',' %}
          {% if siblings contains token and shown < s.max_products %}
            {% assign shown = shown | plus: 1 %}
            <div data-reveal style="--tss-delay: {{ forloop.index0 | times: 0.08 }}s">
              {% render 'tss-product-card', product: p, size: 'standard' %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
{% elsif request.design_mode %}
  <div class="tss-section tss-section--compact">
    <div class="tss-container"><p class="tss-muted tss-small">{{ 'tss.related.empty_editor_hint' | t }}</p></div>
  </div>
{% endif %}

{% stylesheet %}
  .tss-related__grid {
    display: grid;
    gap: 1.25rem;
  }

  @media screen and (min-width: 750px) {
    .tss-related__grid {
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    }

    .tss-related__grid--1 {
      grid-template-columns: minmax(0, 36rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:tss.related.name",
  "class": "section-wrapper",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:tss.common.heading",
      "default": "t:tss.related.heading_default"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:tss.related.max_products",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "tone",
      "label": "t:tss.common.tone",
      "options": [
        { "value": "cream", "label": "t:tss.common.tone_cream" },
        { "value": "card", "label": "t:tss.common.tone_card" },
        { "value": "sage", "label": "t:tss.common.tone_sage" }
      ],
      "default": "card"
    }
  ],
  "presets": [
    {
      "name": "t:tss.related.name",
      "category": "t:tss.common.category"
    }
  ]
}
{% endschema %}
