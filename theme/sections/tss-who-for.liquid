{% comment %}
  Section contract.
  "Who it's for" cards on product pages. Each block can be limited to one product.
  @example
  <!-- templates/product.json -->
{% endcomment %}
{% assign s = section.settings %}
<div class="tss-section tss-who tss-section--{{ s.tone }}">
  <div class="tss-container">
    <div class="tss-section-head tss-section-head--split" data-reveal>
      <div>
        {% if s.eyebrow != blank %}<p class="tss-eyebrow">{{ s.eyebrow | escape }}</p>{% endif %}
        <h2 class="tss-heading">{{ s.heading | escape }}</h2>
      </div>
      {% if s.text != blank %}<div class="tss-lede">{{ s.text }}</div>{% endif %}
    </div>
    <ul class="tss-who__grid" role="list">
      {% for block in section.blocks %}
        {% capture show %}{% render 'tss-product-filter', block_product: block.settings.product, current_product: product %}{% endcapture %}
        {% if show == 'true' %}
          <li class="tss-who__card tss-card tss-who__card--{{ block.settings.kind }}" data-reveal style="--tss-delay: {{ forloop.index0 | times: 0.08 }}s" {{ block.shopify_attributes }}>
            <p class="tss-eyebrow">{{ block.settings.label | escape }}</p>
            <h3 class="tss-who__title">{{ block.settings.title | escape }}</h3>
            {% if block.settings.text != blank %}<p class="tss-who__text">{{ block.settings.text | escape }}</p>{% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .tss-who__grid {
    list-style: none;
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }

  @media screen and (min-width: 750px) {
    .tss-who__grid {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }

  .tss-who__card {
    padding: 1.75rem;
    gap: 0.5rem;
  }

  .tss-who__card--fit {
    background: var(--tss-color-sage-tint);
  }

  .tss-who__card--stretch {
    background: var(--tss-color-cream);
  }

  .tss-who__card .tss-eyebrow {
    margin-block-end: 0.5rem;
  }

  .tss-who__title {
    margin: 0;
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
  }

  .tss-who__text {
    margin: 0;
    color: var(--tss-color-muted);
    line-height: var(--line-height--body-loose);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:tss.who.name",
  "class": "section-wrapper",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    {
      "type": "audience",
      "name": "t:tss.who.audience",
      "settings": [
        {
          "type": "select",
          "id": "kind",
          "label": "t:tss.who.kind",
          "options": [
            { "value": "fit", "label": "t:tss.who.kind_fit" },
            { "value": "stretch", "label": "t:tss.who.kind_stretch" }
          ],
          "default": "fit"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:tss.common.eyebrow",
          "default": "t:tss.who.label_default"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:tss.common.heading",
          "default": "t:tss.who.title_default"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:tss.common.text"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:tss.common.only_for_product",
          "info": "t:tss.common.only_for_product_info"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:tss.common.eyebrow",
      "default": "t:tss.who.eyebrow_default"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:tss.common.heading",
      "default": "t:tss.who.heading_default"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:tss.common.text"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "t:tss.common.tone",
      "options": [
        { "value": "cream", "label": "t:tss.common.tone_cream" },
        { "value": "card", "label": "t:tss.common.tone_card" },
        { "value": "sage", "label": "t:tss.common.tone_sage" }
      ],
      "default": "card"
    }
  ],
  "presets": [
    {
      "name": "t:tss.who.name",
      "category": "t:tss.common.category"
    }
  ]
}
{% endschema %}
