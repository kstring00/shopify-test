{% comment %}
  Section contract.
  FAQ accordion built on native <details>, with FAQPage structured data. Questions can be
  limited to one product. Used on product pages and the About page.
  @example
  <!-- templates/product.json -->
{% endcomment %}
{% liquid
  assign s = section.settings
  assign visible_blocks = ''
  for block in section.blocks
    capture show
      render 'tss-product-filter', block_product: block.settings.product, current_product: product
    endcapture
    if show == 'true'
      assign visible_blocks = visible_blocks | append: block.id | append: ','
    endif
  endfor
%}
<div class="tss-section tss-faq tss-section--{{ s.tone }}">
  <div class="tss-container tss-faq__grid">
    <div class="tss-faq__head" data-reveal>
      {% if s.eyebrow != blank %}<p class="tss-eyebrow">{{ s.eyebrow | escape }}</p>{% endif %}
      <h2 class="tss-heading">{{ s.heading | escape }}</h2>
      {% if s.text != blank %}<div class="tss-lede tss-faq__lede">{{ s.text }}</div>{% endif %}
      {% if s.contact_label != blank %}
        <a class="tss-link" href="{{ s.contact_link | default: '/pages/contact' }}">
          {{ s.contact_label | escape }}
          <svg class="tss-link__arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">{% render 'icon', icon: 'arrow' %}</svg>
        </a>
      {% endif %}
    </div>
    <div class="tss-faq__list" data-reveal style="--tss-delay: 0.1s">
      {% for block in section.blocks %}
        {% assign id_token = block.id | append: ',' %}
        {% if visible_blocks contains id_token %}
          <details class="tss-faq__item" {% if forloop.first and s.open_first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="tss-faq__question">
              <span>{{ block.settings.question | escape }}</span>
              <span class="tss-faq__icon" aria-hidden="true">{{ 'icon-plus.svg' | inline_asset_content }}</span>
            </summary>
            <div class="tss-faq__answer tss-prose">{{ block.settings.answer }}</div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% if s.structured_data %}
  {% capture faq_json %}
    {% for block in section.blocks %}
      {% assign id_token = block.id | append: ',' %}
      {% if visible_blocks contains id_token %}
        {%- unless forloop.first -%},{%- endunless -%}
        {"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | json }}}}
      {% endif %}
    {% endfor %}
  {% endcapture %}
  <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ faq_json | strip_newlines | strip }}]}
  </script>
{% endif %}

{% stylesheet %}
  .tss-faq__grid {
    display: grid;
    gap: calc(var(--tss-stack) * 1.5);
    align-items: start;
  }

  @media screen and (min-width: 990px) {
    .tss-faq__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2rem, 6vw, 6rem);
    }
  }

  .tss-faq__lede {
    margin-block: var(--tss-stack);
  }

  .tss-faq__list {
    border-top: 1px solid var(--tss-color-hairline);
  }

  .tss-faq__item {
    border-bottom: 1px solid var(--tss-color-hairline);
  }

  .tss-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 56px;
    padding: 1rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading--family);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.3;
  }

  .tss-faq__question::-webkit-details-marker {
    display: none;
  }

  .tss-faq__icon {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--tss-color-hairline);
    color: var(--tss-color-sage-deep);
    transition: transform var(--tss-hover-duration) var(--tss-ease), background var(--tss-hover-duration) var(--tss-ease);
  }

  .tss-faq__icon svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .tss-faq__item[open] .tss-faq__icon {
    transform: rotate(45deg);
    background: var(--tss-color-sage-tint);
  }

  .tss-faq__answer {
    padding: 0 0 1.5rem;
    color: var(--tss-color-muted);
    max-width: 60ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .tss-faq__item[open] .tss-faq__answer {
      animation: tss-faq-open var(--tss-reveal-duration) var(--tss-ease);
    }
  }

  @keyframes tss-faq-open {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:tss.faq.name",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "question",
      "name": "t:tss.faq.question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:tss.faq.question",
          "default": "t:tss.faq.question_default"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:tss.faq.answer",
          "default": "t:tss.faq.answer_default"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:tss.common.only_for_product",
          "info": "t:tss.common.only_for_product_info"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:tss.common.eyebrow",
      "default": "t:tss.faq.eyebrow_default"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:tss.common.heading",
      "default": "t:tss.faq.heading_default"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:tss.common.text"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "t:tss.faq.contact_label",
      "default": "t:tss.faq.contact_label_default"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "t:tss.common.link"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "t:tss.faq.open_first",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "structured_data",
      "label": "t:tss.faq.structured_data",
      "default": true
    },
    {
      "type": "select",
      "id": "tone",
      "label": "t:tss.common.tone",
      "options": [
        { "value": "cream", "label": "t:tss.common.tone_cream" },
        { "value": "card", "label": "t:tss.common.tone_card" },
        { "value": "sage", "label": "t:tss.common.tone_sage" }
      ],
      "default": "cream"
    }
  ],
  "presets": [
    {
      "name": "t:tss.faq.name",
      "category": "t:tss.common.category",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Is this editable, or just a PDF?",
            "answer": "<p>Editable. You get template files you can open and change: wording, colors, logo, the lot. A print-ready PDF is one of the things you can export when you are done.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "How is it delivered?",
            "answer": "<p>Instantly. As soon as checkout completes you get a download link on the confirmation page and in your email. Nothing ships.</p>"
          }
        }
      },
      "block_order": ["q1", "q2"]
    }
  ]
}
{% endschema %}
