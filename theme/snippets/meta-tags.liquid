{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.
  The Support Shelf additions: a theme-level title and description for the homepage
  (set in Theme settings > The Support Shelf) and a default social share image used
  whenever a page has no image of its own.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1,viewport-fit=cover"
>
<meta
  name="theme-color"
  content="{{ settings.color_palette.background }}"
>

{%- liquid
  assign seo_title = page_title
  assign seo_description = page_description
  if request.page_type == 'index'
    if settings.tss_home_meta_title != blank
      assign seo_title = settings.tss_home_meta_title
    endif
    if seo_description == blank and settings.tss_home_meta_description != blank
      assign seo_description = settings.tss_home_meta_description
    endif
  endif
  if seo_description == blank and request.page_type == 'collection' and collection.description != blank
    assign seo_description = collection.description | strip_html | truncate: 158
  endif
  if seo_description == blank and request.page_type == 'product' and product.description != blank
    assign seo_description = product.description | strip_html | truncate: 158
  endif
  if seo_description == blank and request.page_type == 'page' and page.content != blank
    assign seo_description = page.content | strip_html | truncate: 158
  endif
  if seo_description == blank
    assign seo_description = shop.description | default: settings.tss_home_meta_description | default: shop.name
  endif

  assign share_image = page_image | default: settings.tss_share_image

  assign og_title = seo_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if share_image -%}
  <meta
    property="og:image"
    content="http:{{ share_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ share_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:width"
    content="{{ share_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ share_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ seo_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless seo_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if seo_description != blank %}
  <meta
    name="description"
    content="{{ seo_description | escape }}"
  >
{% endif %}
